[Unit]
Description=Loom Runtime Instance %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=loom-%i
Group=loom-%i
WorkingDirectory=/opt/loom
Environment=HOME=/home/loom-%i
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node /opt/loom/dist/src/cli.js run --root /home/loom-%i/.loom
Restart=on-failure
RestartSec=10s
KillSignal=SIGTERM
TimeoutStopSec=infinity

[Install]
WantedBy=multi-user.target
