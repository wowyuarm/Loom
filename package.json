{
  "name": "loom",
  "version": "0.0.0",
  "private": true,
  "description": "A continuous, single-Individual agent harness built on DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts/index.d.ts",
      "default": "./lib/contracts/index.js"
    },
    "./clock": {
      "types": "./lib/clock/index.d.ts",
      "default": "./lib/clock/index.js"
    },
    "./log": {
      "types": "./lib/log/index.d.ts",
      "default": "./lib/log/index.js"
    },
    "./runtime-state": {
      "types": "./lib/runtime-state/index.d.ts",
      "default": "./lib/runtime-state/index.js"
    },
    "./resident-context": {
      "types": "./lib/resident-context/index.d.ts",
      "default": "./lib/resident-context/index.js"
    },
    "./context-continuity": {
      "types": "./lib/context-continuity/host.d.ts",
      "default": "./lib/context-continuity/host.js"
    },
    "./agent-runtime": {
      "types": "./lib/agent-runtime/index.d.ts",
      "default": "./lib/agent-runtime/index.js"
    },
    "./orientation": {
      "types": "./lib/orientation/index.d.ts",
      "default": "./lib/orientation/index.js"
    },
    "./time-context": {
      "types": "./lib/time-context/index.d.ts",
      "default": "./lib/time-context/index.js"
    },
    "./after-interaction": {
      "types": "./lib/after-interaction/index.d.ts",
      "default": "./lib/after-interaction/index.js"
    },
    "./workspace-history": {
      "types": "./lib/workspace-history/index.d.ts",
      "default": "./lib/workspace-history/index.js"
    },
    "./turn-failures": {
      "types": "./lib/turn-failures/index.d.ts",
      "default": "./lib/turn-failures/index.js"
    },
    "./channels": {
      "types": "./lib/channels/index.d.ts",
      "default": "./lib/channels/index.js"
    },
    "./skills": {
      "types": "./lib/skills/index.d.ts",
      "default": "./lib/skills/index.js"
    }
  },
  "bin": {
    "loom": "bin/loom.mjs"
  },
  "files": [
    "bin/loom.mjs",
    "lib/**/*",
    "cordis.patch.yml",
    "presets/**/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/check-seeded-skills.mjs && vitest run",
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check:seeded-skills": "node scripts/check-seeded-skills.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@contexera/dsh-channel-gateway": "0.1.6",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/cordis-plugin-timer": "1.1.6",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-base": "0.2.0-rc.2",
    "@deepseek-ai/dsh-headless": "0.2.0-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-sqlite": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@wowyuarm/dsh-context-continuity": "^0.3.0",
    "@wowyuarm/dsh-jev": "0.1.1",
    "js-yaml": "^4.3.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/loom.patch.yml"
      ]
    }
  }
}
