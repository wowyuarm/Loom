{
  "name": "loom",
  "version": "0.0.0",
  "private": true,
  "description": "A continuous, single-Individual agent harness built on DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts/index.d.ts",
      "default": "./lib/contracts/index.js"
    },
    "./clock": {
      "types": "./lib/clock/index.d.ts",
      "default": "./lib/clock/index.js"
    },
    "./runtime-state": {
      "types": "./lib/runtime-state/index.d.ts",
      "default": "./lib/runtime-state/index.js"
    },
    "./resident-context": {
      "types": "./lib/resident-context/index.d.ts",
      "default": "./lib/resident-context/index.js"
    },
    "./context-continuity": {
      "types": "./lib/context-continuity/host.d.ts",
      "default": "./lib/context-continuity/host.js"
    },
    "./agent-runtime": {
      "types": "./lib/agent-runtime/index.d.ts",
      "default": "./lib/agent-runtime/index.js"
    },
    "./orientation": {
      "types": "./lib/orientation/index.d.ts",
      "default": "./lib/orientation/index.js"
    },
    "./channels": {
      "types": "./lib/channels/index.d.ts",
      "default": "./lib/channels/index.js"
    }
  },
  "files": [
    "lib/**/*",
    "cordis.patch.yml"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-include": "^1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@deepseek-ai/dsh": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-base": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-headless": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm-deepseek": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-storage": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-storage-sqlite": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@types/node": "^24.0.0",
    "@wowyuarm/dsh-channel-gateway": "^0.1.0",
    "@wowyuarm/dsh-context-continuity": "0.1.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
